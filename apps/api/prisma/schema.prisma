generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  ACCOUNTING
  SAFETY
}

enum LoadStatus {
  DRAFT
  CONFIRMED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum DocumentKind {
  RATE_CONFIRMATION
  POD
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  fullName      String
  role          UserRole
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  assignedLoads Load[]   @relation("AssignedDriver")
}

model Load {
  id               String                @id @default(uuid()) @db.Uuid
  sequenceNumber   Int?                  @unique
  internalLoadId   String?               @unique
  brokerLoadNumber String?
  status           LoadStatus            @default(DRAFT)
  assignedDriverId String?               @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  assignedDriver   User?                 @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  stops            Stop[]
  documents        LoadDocument[]
  fieldVisibility  LoadFieldVisibility[]
}

model Stop {
  id              String    @id @default(uuid()) @db.Uuid
  loadId          String    @db.Uuid
  type            StopType
  position        Int
  facilityName    String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  countryCode     String    @default("US") @db.Char(2)
  appointmentAt   DateTime? @db.Timestamptz(3)
  referenceNumber String?
  instructions    String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  load            Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@unique([loadId, position])
}

model LoadDocument {
  id         String              @id @default(uuid()) @db.Uuid
  loadId     String              @db.Uuid
  kind       DocumentKind
  version    Int
  filename   String
  mimeType   String
  storageKey String              @unique
  isCurrent  Boolean             @default(true)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  load       Load                @relation(fields: [loadId], references: [id], onDelete: Cascade)
  extraction DocumentExtraction?

  @@unique([loadId, kind, version])
}

model DocumentExtraction {
  id          String           @id @default(uuid()) @db.Uuid
  documentId  String           @unique @db.Uuid
  status      ExtractionStatus @default(PENDING)
  provider    String
  model       String?
  result      Json?
  error       String?
  startedAt   DateTime?        @db.Timestamptz(3)
  completedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  document    LoadDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model LoadFieldVisibility {
  id              String   @id @default(uuid()) @db.Uuid
  loadId          String   @db.Uuid
  field           String
  visibleToDriver Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  load            Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@unique([loadId, field])
}
