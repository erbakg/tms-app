# Copy this file to .env for local API development. Do not commit real credentials.
DATABASE_URL="postgresql://312kg:312kg_local_only@localhost:5433/312kg_tms?schema=public"
PORT=3000
AUTH_JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_JWT_EXPIRES_IN_SECONDS=28800
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="312kg-tms"
S3_ACCESS_KEY_ID="312kg_local_only"
S3_SECRET_ACCESS_KEY="312kg_local_only"
REDIS_URL="redis://localhost:6380"
AI_PROVIDER="mock"
